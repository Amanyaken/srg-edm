dge="1" parent="1" source="e10" target="e16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="e11" target="e16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="e12" target="e16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="e13" target="e16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="e14" target="e16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="e15" target="e16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="TRANSFORM&lt;br&gt;• phone to E.164 text&lt;br&gt;• dates to YYYY-MM-DD&lt;br&gt;• gender to fixed list&lt;br&gt;• district check vs master list&lt;br&gt;• units to one standard&lt;br&gt;• returns kept + flagged&lt;br&gt;• currency normalised&lt;br&gt;• product ID lookup (master)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="150" width="210" height="230" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="e16" target="e24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="MATCH AND MERGE&lt;br&gt;B3 score rules:&lt;br&gt;85+ auto-merge&lt;br&gt;60-84 steward review&lt;br&gt;below 60 different&lt;br&gt;originals kept (un-merge)&lt;br&gt;output: golden customer ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="160" width="160" height="210" as="geometry"/></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="e24" target="e26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="LOAD 1: DIMENSIONS FIRST&lt;br&gt;dim_customer, dim_product (SCD2), dim_store (SCD2), dim_date&lt;br&gt;default 'Unknown' row (-1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="990" y="90" width="190" height="120" as="geometry"/></mxCell><mxCell id="e29" value="LOAD 2: FACT&lt;br&gt;fact_sales&lt;br&gt;(keys looked up from dimensions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="990" y="270" width="190" height="100" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="e26" target="e28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="e28" target="e29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="WAREHOUSE&lt;br&gt;star schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="160" width="150" height="90" as="geometry"/></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="e29" target="e32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="e28" target="e32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e35" value="DASHBOARD&lt;br&gt;(Power BI)&lt;br&gt;masked analytics copy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1220" y="300" width="150" height="90" as="geometry"/></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="e32" target="e35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e37" value="REVIEW / REJECT LOG&lt;br&gt;failed phone length, bad district,&lt;br&gt;unmatched product -&gt; steward queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="430" width="210" height="80" as="geometry"/></mxCell><mxCell id="e38" value="fails check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="e24" target="e37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e39" value="UNKNOWN-ROW LOG&lt;br&gt;unmatched keys loaded to -1&lt;br&gt;and counted as a quality metric" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="430" width="190" height="80" as="geometry"/></mxCell><mxCell id="e40" value="no match" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="e29" target="e39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e41" value="Error handling: bad data is never dropped silently. It is logged, counted and sent to a named steward." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="430" width="170" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>